#: src/View/ConfigViewModel.php:163
#, php-format
msgid ""
"The selected images total %1$s, above the server limit per save (%2$s). Save "
"in steps."
msgstr ""
"As imagens selecionadas somam %1$s, acima do limite do servidor por envio "
"(%2$s). Salve em etapas."

#: src/View/ConfigViewModel.php:164
#, php-format
msgid "Low contrast (%s:1). WCAG recommends at least 4.5:1."
msgstr "Contraste baixo (%s:1). A WCAG recomenda no mínimo 4,5:1."

#: src/View/ConfigViewModel.php:165
#, php-format
msgid "Good contrast (%s:1)."
msgstr "Bom contraste (%s:1)."

#: src/View/ConfigViewModel.php:166
msgid "Will be removed when saving (GLPI default restored)."
msgstr "Será removida ao salvar (volta o padrão do GLPI)."

#: src/View/ConfigViewModel.php:167
msgid "New image selected — not saved yet."
msgstr "Nova imagem selecionada — ainda não salva."

#: templates/config.html.twig:34
msgid ""
"Images keep their original quality (they are not resized or recompressed). "
"Each field shows the recommended, minimum and maximum size; files are "
"checked as soon as they are selected."
msgstr ""
"As imagens mantêm a qualidade original (não são redimensionadas nem "
"recomprimidas). Cada campo mostra o tamanho recomendado, mínimo e máximo; os "
"arquivos são verificados assim que selecionados."

#: templates/config.html.twig:36
msgid "Server limits:"
msgstr "Limites do servidor:"

#: templates/config.html.twig:37
msgid "per file"
msgstr "por arquivo"

#: templates/config.html.twig:38
msgid "per save (all files together)"
msgstr "por envio (todos os arquivos juntos)"

#: templates/config.html.twig:50
msgid "Identity"
msgstr "Identidade"

#: templates/config.html.twig:54
msgid "Application name"
msgstr "Nome da aplicação"

#: templates/config.html.twig:58
msgid ""
"Browser tab title, e-mail notification footer and two-factor authentication "
"label. Empty = \"GLPI\"."
msgstr ""
"Título da aba do navegador, rodapé das notificações por e-mail e rótulo da "
"autenticação em dois fatores. Vazio = \"GLPI\"."

#: templates/config.html.twig:61
msgid "Login screen note"
msgstr "Aviso na tela de login"

#: templates/config.html.twig:64
msgid "e.g. IT Service Desk — ext. 1234"
msgstr "ex.: Central de Serviços de TI — ramal 1234"

#: templates/config.html.twig:66
msgid ""
"Short plain text shown below the login button (support contact, notice...)."
msgstr ""
"Texto curto exibido abaixo do botão de login (contato do suporte, aviso...)."

#: templates/config.html.twig:87
msgid "Background darkening"
msgstr "Escurecimento do fundo"

#: templates/config.html.twig:93
msgid "Improves the readability of texts over light photos."
msgstr "Melhora a leitura dos textos sobre fotos claras."

#: templates/config.html.twig:102
