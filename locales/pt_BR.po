msgstr "Celular na vertical. Usa o fundo de celular quando enviado."

#: templates/config.html.twig:210
msgid ""
"Left: expanded menu. Middle: collapsed menu. Colors apply only when enabled."
msgstr ""
"Esquerda: menu expandido. Centro: menu recolhido. As cores só se aplicam "
"quando ativadas."

